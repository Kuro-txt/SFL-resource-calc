{
  "rewrites": [
    {
      "source": "/api/nfts",
      "destination": "/api/nft"
    },
    {
      "source": "/api/weeklyYields",
      "destination": "/api/yields?type=weekly"
    },
    {
      "source": "/api/monthlyYields",
      "destination": "/api/yields?type=monthly"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
